@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

@* Cada link se muestra solo si el usuario cumple la política de esa pantalla.
   Ocultar el link es UX: la página en sí también exige la política con [Authorize]. *@
<nav class="side-nav">
    <NavLink class="side-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>

    @foreach (var menuGroup in visibleGroups)
    {
        <div class="side-section">@menuGroup.Title</div>
        @foreach (var item in menuGroup.Items)
        {
            <NavLink class="side-link" href="@item.Href">@item.Text</NavLink>
        }
    }
</nav>

@code {
    private record Item(string Text, string Href, string Policy);
    private record MenuGroup(string Title, Item[] Items);

    // Para sumar una pantalla al menú alcanza con agregar una línea acá.
    private static readonly MenuGroup[] groups =
    [
        new("Equipos",
        [
            new("Instrumentos", "instruments", "InstrumentsRead"),
            new("Historial de estados", "instrument-status-history", "InstrumentStatusHistoryRead"),
            new("Tipos de instrumento", "instrument-types", "InstrumentTypesRead"),
            new("Áreas", "areas", "AreasRead"),
            new("Ubicaciones", "locations", "LocationsRead")
        ]),
        new("Calibración",
        [
            new("Procedimientos", "procedures", "ProceduresRead"),
            new("Patrones de referencia", "reference-standards", "ReferenceStandardsRead")
        ])
    ];

    private readonly List<MenuGroup> visibleGroups = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        foreach (var menuGroup in groups)
        {
            var items = new List<Item>();
            foreach (var item in menuGroup.Items)
            {
                if ((await AuthorizationService.AuthorizeAsync(user, item.Policy)).Succeeded)
                    items.Add(item);
            }

            // Si el perfil no ve ninguna pantalla del grupo, tampoco se muestra el título.
            if (items.Count > 0)
                visibleGroups.Add(new MenuGroup(menuGroup.Title, items.ToArray()));
        }
    }
}
