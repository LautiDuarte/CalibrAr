@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <header class="navbar navbar-expand bg-body-tertiary border-bottom px-3">
            <a class="navbar-brand fw-semibold" href="">CalibrAr</a>

            <NavMenu />

            <div class="d-flex align-items-center ms-auto">
                <span class="me-3 text-secondary">@context.User.Identity?.Name</span>

                @* Form HTML común (sin @onsubmit): el navegador hace un POST real a /logout,
                   no pasa por el circuito, porque borrar la cookie requiere una respuesta HTTP. *@
                <form action="logout" method="post" class="m-0">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Cerrar sesión</button>
                </form>
            </div>
        </header>
    </Authorized>
</AuthorizeView>

<main class="container py-4">
    @Body
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
