@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <header class="top-bar">
            <NavMenu />

            <div class="user-info">
                <span>Hola, @context.User.Identity?.Name</span>

                @* Form HTML común (sin @onsubmit): el navegador hace un POST real a /logout,
                   no pasa por el circuito, porque borrar la cookie requiere una respuesta HTTP. *@
                <form action="logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit">Cerrar sesión</button>
                </form>
            </div>
        </header>
    </Authorized>
</AuthorizeView>

<main>
    @Body
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
