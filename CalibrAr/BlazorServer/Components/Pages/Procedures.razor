@page "/procedures"
@attribute [Authorize(Policy = "ProceduresRead")]
@inject ProcedureApiClient ProcedureApiClient
@inject NavigationManager NavigationManager
@inject FlashService Flash
@inject IJSRuntime JS

<PageTitle>Procedimientos - CalibrAr</PageTitle>

<PageHeader Title="Procedimientos" Count="procedures?.Count">
    <Actions>
        <AuthorizeView Policy="ProceduresCreate">
            <a href="procedures/new" class="btn btn-primary">Nuevo procedimiento</a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<FlashBanner />

<ErrorBanner @bind-Message="errorMessage" />

@if (procedures == null)
{
    <p class="text-secondary">Cargando...</p>
}
else if (procedures.Count == 0)
{
    <p class="text-secondary">No hay procedimientos cargados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Versión</th>
                    <th>Tipo de instrumento</th>
                    <th>Aprobado</th>
                    <th>Documento</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var procedure in procedures)
                {
                    <tr>
                        <td class="font-monospace">@procedure.Code</td>
                        <td>@procedure.Name</td>
                        <td>@procedure.VersionNumber</td>
                        <td>@procedure.InstrumentTypeName</td>
                        <td>@procedure.ApprovedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(procedure.DocumentUrl))
                            {
                                <a href="@procedure.DocumentUrl" target="_blank" rel="noopener noreferrer">Ver</a>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                        <td>
                            <StatusBadge Text="@(procedure.IsActive ? "Sí" : "No")" Kind="@(procedure.IsActive ? "success" : "secondary")" />
                        </td>
                        <td class="text-end text-nowrap">
                            <AuthorizeView Policy="ProceduresUpdate">
                                <a href="procedures/@procedure.Id/edit" class="btn btn-sm btn-outline-primary">Editar</a>
                            </AuthorizeView>
                            <AuthorizeView Policy="ProceduresDelete">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(procedure)">Eliminar</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProcedureDTO>? procedures;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProcedures();
    }

    private async Task LoadProcedures()
    {
        try
        {
            procedures = await ProcedureApiClient.GetAllAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
            procedures = new List<ProcedureDTO>();
        }
    }

    private async Task DeleteAsync(ProcedureDTO procedure)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el procedimiento \"{procedure.Code}\"?");
        if (!confirmed)
            return;

        try
        {
            await ProcedureApiClient.DeleteAsync(procedure.Id);
            errorMessage = null;
            await LoadProcedures();
            Flash.Success($"Procedimiento \"{procedure.Code}\" eliminado.");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }
}
