@page "/reference-standards"
@attribute [Authorize(Policy = "ReferenceStandardsRead")]
@inject ReferenceStandardApiClient ReferenceStandardApiClient
@inject NavigationManager NavigationManager
@inject FlashService Flash
@inject IJSRuntime JS

<PageTitle>Patrones de referencia - CalibrAr</PageTitle>

<PageHeader Title="Patrones de referencia" Count="standards?.Count">
    <Actions>
        <AuthorizeView Policy="ReferenceStandardsCreate">
            <a href="reference-standards/new" class="btn btn-primary">Nuevo patrón</a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<FlashBanner />

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (standards == null)
{
    <p class="text-secondary">Cargando...</p>
}
else if (standards.Count == 0)
{
    <p class="text-secondary">No hay patrones de referencia cargados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Organismo certificante</th>
                    <th>N° de certificado</th>
                    <th>Emisión</th>
                    <th>Vencimiento</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var standard in standards)
                {
                    <tr>
                        <td>@standard.Description</td>
                        <td>@standard.CertifyingBody</td>
                        <td class="font-monospace">@standard.CertificateNumber</td>
                        <td>@standard.CertificateIssuedAt.ToString("dd/MM/yyyy")</td>
                        <td>@standard.CertificateExpiresAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (!standard.IsActive)
                            {
                                <StatusBadge Text="Inactivo" Kind="secondary" />
                            }
                            else if (IsExpired(standard))
                            {
                                <StatusBadge Text="Vencido" Kind="danger" />
                            }
                            else
                            {
                                <StatusBadge Text="Vigente" Kind="success" />
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <AuthorizeView Policy="ReferenceStandardsUpdate">
                                <a href="reference-standards/@standard.Id/edit" class="btn btn-sm btn-outline-primary">Editar</a>
                            </AuthorizeView>
                            <AuthorizeView Policy="ReferenceStandardsDelete">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(standard)">Eliminar</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ReferenceStandardDTO>? standards;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStandards();
    }

    // Vencido se calcula con la fecha del certificado, no se guarda. Si además está inactivo, se muestra "Inactivo".
    private static bool IsExpired(ReferenceStandardDTO standard) => standard.CertificateExpiresAt.Date < DateTime.Today;

    private async Task LoadStandards()
    {
        try
        {
            standards = await ReferenceStandardApiClient.GetAllAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
            standards = new List<ReferenceStandardDTO>();
        }
    }

    private async Task DeleteAsync(ReferenceStandardDTO standard)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el patrón \"{standard.Description}\"?");
        if (!confirmed)
            return;

        try
        {
            await ReferenceStandardApiClient.DeleteAsync(standard.Id);
            errorMessage = null;
            await LoadStandards();
            Flash.Success($"Patrón \"{standard.Description}\" eliminado.");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }
}
