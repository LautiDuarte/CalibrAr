@page "/instrument-types"
@attribute [Authorize(Policy = "InstrumentTypesRead")]
@inject InstrumentTypeApiClient InstrumentTypeApiClient
@inject NavigationManager NavigationManager
@inject FlashService Flash
@inject IJSRuntime JS

<PageTitle>Tipos de instrumento - CalibrAr</PageTitle>

<PageHeader Title="Tipos de instrumento" Count="instrumentTypes?.Count">
    <Actions>
        <AuthorizeView Policy="InstrumentTypesCreate">
            <a href="instrument-types/new" class="btn btn-primary">Nuevo tipo de instrumento</a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<FlashBanner />

<ErrorBanner @bind-Message="errorMessage" />

@if (instrumentTypes == null)
{
    <p class="text-secondary">Cargando...</p>
}
else if (instrumentTypes.Count == 0)
{
    <p class="text-secondary">No hay tipos de instrumento cargados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Unidad</th>
                    <th class="text-end">Error máximo</th>
                    <th class="text-end">Frecuencia (meses)</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instrumentType in instrumentTypes)
                {
                    <tr>
                        <td>@instrumentType.Name</td>
                        <td>@instrumentType.MeasurementUnit</td>
                        <td class="text-end">@instrumentType.MaxAllowedError</td>
                        <td class="text-end">@instrumentType.CalibrationFrequencyMonths</td>
                        <td>
                            <StatusBadge Text="@(instrumentType.IsActive ? "Sí" : "No")" Kind="@(instrumentType.IsActive ? "success" : "secondary")" />
                        </td>
                        <td class="text-end text-nowrap">
                            <AuthorizeView Policy="InstrumentTypesUpdate">
                                <a href="instrument-types/@instrumentType.Id/edit" class="btn btn-sm btn-outline-primary">Editar</a>
                            </AuthorizeView>
                            <AuthorizeView Policy="InstrumentTypesDelete">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(instrumentType)">Eliminar</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<InstrumentTypeDTO>? instrumentTypes;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstrumentTypes();
    }

    private async Task LoadInstrumentTypes()
    {
        try
        {
            instrumentTypes = await InstrumentTypeApiClient.GetAllAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
            instrumentTypes = new List<InstrumentTypeDTO>();
        }
    }

    private async Task DeleteAsync(InstrumentTypeDTO instrumentType)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el tipo de instrumento \"{instrumentType.Name}\"?");
        if (!confirmed)
            return;

        try
        {
            await InstrumentTypeApiClient.DeleteAsync(instrumentType.Id);
            errorMessage = null;
            await LoadInstrumentTypes();
            Flash.Success($"Tipo de instrumento \"{instrumentType.Name}\" eliminado.");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }
}
