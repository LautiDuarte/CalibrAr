@page "/areas"
@attribute [Authorize(Policy = "AreasRead")]
@inject AreaApiClient AreaApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Áreas - CalibrAr</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Áreas</h1>
    <AuthorizeView Policy="AreasCreate">
        <a href="areas/new" class="btn btn-primary">Nueva área</a>
    </AuthorizeView>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (areas == null)
{
    <p class="text-secondary">Cargando...</p>
}
else if (areas.Count == 0)
{
    <p class="text-secondary">No hay áreas cargadas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Responsable</th>
                    <th>Ubicación</th>
                    <th>Activa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var area in areas)
                {
                    <tr>
                        <td>@area.Name</td>
                        <td>@area.Responsible</td>
                        <td>@area.LocationName</td>
                        <td>
                            <span class="badge @(area.IsActive ? "text-bg-success" : "text-bg-secondary")">@(area.IsActive ? "Sí" : "No")</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <AuthorizeView Policy="AreasUpdate">
                                <a href="areas/@area.Id/edit" class="btn btn-sm btn-outline-primary">Editar</a>
                            </AuthorizeView>
                            <AuthorizeView Policy="AreasDelete">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(area)">Eliminar</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AreaDTO>? areas;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAreas();
    }

    private async Task LoadAreas()
    {
        try
        {
            areas = await AreaApiClient.GetAllAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
            areas = new List<AreaDTO>();
        }
    }

    private async Task DeleteAsync(AreaDTO area)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el área \"{area.Name}\"?");
        if (!confirmed)
            return;

        try
        {
            await AreaApiClient.DeleteAsync(area.Id);
            errorMessage = null;
            await LoadAreas();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }
}
