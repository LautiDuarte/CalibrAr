@page "/locations"
@attribute [Authorize(Policy = "LocationsRead")]
@inject LocationApiClient LocationApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Ubicaciones - CalibrAr</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Ubicaciones</h1>
    <AuthorizeView Policy="LocationsCreate">
        <a href="locations/new" class="btn btn-primary">Nueva ubicación</a>
    </AuthorizeView>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (locations == null)
{
    <p class="text-secondary">Cargando...</p>
}
else if (locations.Count == 0)
{
    <p class="text-secondary">No hay ubicaciones cargadas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Activa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in locations)
                {
                    <tr>
                        <td>@location.Name</td>
                        <td>@location.Address</td>
                        <td>
                            <span class="badge @(location.IsActive ? "text-bg-success" : "text-bg-secondary")">@(location.IsActive ? "Sí" : "No")</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <AuthorizeView Policy="LocationsUpdate">
                                <a href="locations/@location.Id/edit" class="btn btn-sm btn-outline-primary">Editar</a>
                            </AuthorizeView>
                            <AuthorizeView Policy="LocationsDelete">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(location)">Eliminar</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LocationDTO>? locations;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocations();
    }

    private async Task LoadLocations()
    {
        try
        {
            locations = await LocationApiClient.GetAllAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
            locations = new List<LocationDTO>();
        }
    }

    private async Task DeleteAsync(LocationDTO location)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la ubicación \"{location.Name}\"?");
        if (!confirmed)
            return;

        try
        {
            await LocationApiClient.DeleteAsync(location.Id);
            errorMessage = null;
            await LoadLocations();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }
}
