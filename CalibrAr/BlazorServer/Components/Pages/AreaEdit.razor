@page "/areas/{Id:int}/edit"
@attribute [Authorize(Policy = "AreasUpdate")]
@inject AreaApiClient AreaApiClient
@inject LocationApiClient LocationApiClient
@inject NavigationManager NavigationManager
@inject FlashService Flash

<PageTitle>Editar área - CalibrAr</PageTitle>

<PageHeader Title="Editar área">
    <Actions>
        <a href="areas" class="btn btn-sm btn-outline-secondary">← Volver</a>
    </Actions>
</PageHeader>

@if (errorMessage != null)
{
    <div class="alert alert-danger form-narrow">@errorMessage</div>
}

@if (model == null || locations == null)
{
    @if (errorMessage == null)
    {
        <p class="text-secondary">Cargando...</p>
    }
}
else
{
    <AreaForm Model="model" Locations="locations" OnValidSubmit="SaveAsync" Saving="saving" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private AreaForm.AreaFormModel? model;
    private List<LocationDTO>? locations;
    private DateTime createdAt;
    private string? errorMessage;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AreaDTO area = await AreaApiClient.GetAsync(Id);
            locations = await LocationApiClient.GetAllAsync();
            createdAt = area.CreatedAt;
            model = new AreaForm.AreaFormModel
            {
                Name = area.Name,
                Responsible = area.Responsible ?? string.Empty,
                LocationId = area.LocationId,
                IsActive = area.IsActive
            };
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            await AreaApiClient.UpdateAsync(new AreaDTO
            {
                Id = Id,
                Name = model!.Name,
                Responsible = model.Responsible,
                LocationId = model.LocationId,
                IsActive = model.IsActive,
                CreatedAt = createdAt
            });
            Flash.Success("Área actualizada.");
            NavigationManager.NavigateTo("areas");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
        finally
        {
            saving = false;
        }
    }
}
