@page "/instrument-types/{Id:int}/edit"
@attribute [Authorize(Policy = "InstrumentTypesUpdate")]
@inject InstrumentTypeApiClient InstrumentTypeApiClient
@inject NavigationManager NavigationManager

<PageTitle>Editar tipo de instrumento - CalibrAr</PageTitle>

<h1 class="h3 mb-3">Editar tipo de instrumento</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger form-narrow">@errorMessage</div>
}

@if (model == null)
{
    @if (errorMessage == null)
    {
        <p class="text-secondary">Cargando...</p>
    }
    else
    {
        <a href="instrument-types" class="btn btn-outline-secondary">Volver</a>
    }
}
else
{
    <InstrumentTypeForm Model="model" OnValidSubmit="SaveAsync" Saving="saving" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InstrumentTypeForm.InstrumentTypeFormModel? model;
    private DateTime createdAt;
    private string? errorMessage;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            InstrumentTypeDTO instrumentType = await InstrumentTypeApiClient.GetAsync(Id);
            createdAt = instrumentType.CreatedAt;
            model = new InstrumentTypeForm.InstrumentTypeFormModel
            {
                Name = instrumentType.Name,
                Description = instrumentType.Description,
                MeasurementUnit = instrumentType.MeasurementUnit,
                MaxAllowedError = instrumentType.MaxAllowedError,
                CalibrationFrequencyMonths = instrumentType.CalibrationFrequencyMonths,
                IsActive = instrumentType.IsActive
            };
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            await InstrumentTypeApiClient.UpdateAsync(new InstrumentTypeDTO
            {
                Id = Id,
                Name = model!.Name,
                Description = model.Description,
                MeasurementUnit = model.MeasurementUnit,
                MaxAllowedError = model.MaxAllowedError,
                CalibrationFrequencyMonths = model.CalibrationFrequencyMonths,
                IsActive = model.IsActive,
                CreatedAt = createdAt
            });
            NavigationManager.NavigateTo("instrument-types");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
        finally
        {
            saving = false;
        }
    }
}
