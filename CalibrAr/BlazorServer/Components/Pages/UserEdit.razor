@page "/users/{Id:int}/edit"
@attribute [Authorize(Policy = "UsersUpdate")]
@inject UserApiClient UserApiClient
@inject CurrentUser CurrentUser
@inject NavigationManager NavigationManager
@inject FlashService Flash

<PageTitle>Editar usuario - CalibrAr</PageTitle>

<PageHeader Title="Editar usuario">
    <Actions>
        <a href="users" class="btn btn-sm btn-outline-secondary">← Volver</a>
    </Actions>
</PageHeader>

<ErrorBanner @bind-Message="errorMessage" Persistent="@(model == null)" />

@if (model == null)
{
    @if (errorMessage == null)
    {
        <p class="text-secondary">Cargando...</p>
    }
}
else
{
    <UserForm Model="model" IsSelf="isSelf" OnValidSubmit="SaveAsync" Saving="saving" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UserForm.UserFormModel? model;
    private int? currentUserId;
    private bool isSelf;
    private DateTime? lastLoginAt;
    private DateTime createdAt;
    private string? errorMessage;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            UserDTO user = await UserApiClient.GetAsync(Id);
            currentUserId = await CurrentUser.GetIdAsync();
            isSelf = currentUserId == Id;
            lastLoginAt = user.LastLoginAt;
            createdAt = user.CreatedAt;
            model = new UserForm.UserFormModel
            {
                FullName = user.FullName,
                Email = user.Email,
                Role = user.Role,
                IsActive = user.IsActive
            };
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            // La API sabe quién pide el cambio por el token y con eso aplica las reglas
            // de que nadie se cambie el rol ni se desactive a sí mismo.
            // La contraseña no viaja: la API no permite cambiarla desde acá.
            await UserApiClient.UpdateAsync(new UserDTO
            {
                Id = Id,
                FullName = model!.FullName.Trim(),
                Email = model.Email.Trim(),
                Role = model.Role,
                IsActive = model.IsActive,
                LastLoginAt = lastLoginAt,
                CreatedAt = createdAt
            });
            Flash.Success("Usuario actualizado.");
            NavigationManager.NavigateTo("users");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
        finally
        {
            saving = false;
        }
    }
}
