@page "/instruments/new"
@attribute [Authorize(Policy = "InstrumentsCreate")]
@inject InstrumentApiClient InstrumentApiClient
@inject InstrumentTypeApiClient InstrumentTypeApiClient
@inject AreaApiClient AreaApiClient
@inject NavigationManager NavigationManager

<PageTitle>Nuevo instrumento - CalibrAr</PageTitle>

<h1>Nuevo instrumento</h1>

@if (errorMessage != null)
{
    <p class="validation-message">@errorMessage</p>
}

@if (instrumentTypes == null || areas == null)
{
    @if (errorMessage == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <a href="instruments">Volver</a>
    }
}
else
{
    <InstrumentForm Model="model" InstrumentTypes="instrumentTypes" Areas="areas" OnValidSubmit="SaveAsync" Saving="saving" />
}

@code {
    private InstrumentForm.InstrumentFormModel model = new();
    private List<InstrumentTypeDTO>? instrumentTypes;
    private List<AreaDTO>? areas;
    private string? errorMessage;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            instrumentTypes = await InstrumentTypeApiClient.GetAllAsync();
            areas = await AreaApiClient.GetAllAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            await InstrumentApiClient.AddAsync(new InstrumentDTO
            {
                Code = model.Code.Trim(),
                Name = model.Name,
                SerialNumber = model.SerialNumber,
                Brand = model.Brand,
                Model = model.Model,
                Status = model.Status,
                MaxAllowedError = model.MaxAllowedError,
                CalibrationFrequencyMonths = model.CalibrationFrequencyMonths,
                InstrumentTypeId = model.InstrumentTypeId,
                InstrumentTypeName = string.Empty,
                AreaId = model.AreaId,
                AreaName = string.Empty
            });
            NavigationManager.NavigateTo("instruments");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
        finally
        {
            saving = false;
        }
    }
}
