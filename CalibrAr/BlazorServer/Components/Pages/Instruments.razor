@page "/instruments"
@attribute [Authorize(Policy = "InstrumentsRead")]
@inject InstrumentApiClient InstrumentApiClient
@inject NavigationManager NavigationManager
@inject FlashService Flash
@inject IJSRuntime JS

<PageTitle>Instrumentos - CalibrAr</PageTitle>

<PageHeader Title="Instrumentos" Count="instruments?.Count" Subtitle="@FilterSubtitle">
    <Actions>
        <AuthorizeView Policy="InstrumentsCreate">
            <a href="instruments/new" class="btn btn-primary">Nuevo instrumento</a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<FlashBanner />

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (instruments == null)
{
    <p class="text-secondary">Cargando...</p>
}
else if (instruments.Count == 0)
{
    <p class="text-secondary">No hay instrumentos cargados.</p>
}
else
{
    var filtered = FilteredInstruments;

    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="search" class="form-control" placeholder="Buscar por código, nombre, marca o modelo"
                   @bind="searchText" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="statusFilter">
                <option value="">Todos los estados</option>
                @foreach (var status in Enum.GetValues<InstrumentStatusDTO>())
                {
                    <option value="@status">@InstrumentForm.StatusText(status.ToString())</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="areaFilter">
                <option value="">Todas las áreas</option>
                @foreach (var areaName in areaNames)
                {
                    <option value="@areaName">@areaName</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-grid">
            @if (HasFilters)
            {
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Limpiar</button>
            }
        </div>
    </div>

    <div class="form-check mb-3">
        <input type="checkbox" id="hideDecommissioned" class="form-check-input" @bind="hideDecommissioned" />
        <label for="hideDecommissioned" class="form-check-label">Ocultar dados de baja</label>
    </div>

    @if (filtered.Count == 0)
    {
        <p class="text-secondary">Ningún instrumento coincide con los filtros.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Área</th>
                        <th>Estado</th>
                        <th>Próxima calibración</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instrument in filtered)
                    {
                        <tr class="clickable-row" @onclick="() => OpenDetails(instrument)">
                            <td class="font-monospace text-nowrap"><a href="instruments/@instrument.Id" @onclick:stopPropagation="true">@instrument.Code</a></td>
                            <td>
                                <div>@instrument.Name</div>
                                @if (BrandAndModel(instrument) != string.Empty)
                                {
                                    <div class="small text-secondary">@BrandAndModel(instrument)</div>
                                }
                            </td>
                            <td>@instrument.InstrumentTypeName</td>
                            <td>@instrument.AreaName</td>
                            <td>
                                <StatusBadge Text="@InstrumentForm.StatusText(instrument.Status)" Kind="@InstrumentForm.StatusKind(instrument.Status)" />
                            </td>
                            <td>@(instrument.NextCalibrationDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            @* Los botones no abren el detalle de la fila: solo hacen lo suyo. *@
                            <td class="text-end text-nowrap" @onclick:stopPropagation="true">
                                <AuthorizeView Policy="InstrumentsUpdate">
                                    <a href="instruments/@instrument.Id/edit" class="btn btn-sm btn-outline-primary">Editar</a>
                                </AuthorizeView>
                                <AuthorizeView Policy="InstrumentsDelete">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(instrument)">Eliminar</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<InstrumentDTO>? instruments;
    private List<string> areaNames = new();
    private string? errorMessage;

    private string searchText = string.Empty;
    private string statusFilter = string.Empty;
    private string areaFilter = string.Empty;
    private bool hideDecommissioned;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstruments();
    }

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(searchText) || statusFilter != string.Empty || areaFilter != string.Empty || hideDecommissioned;

    // Los filtros se aplican en memoria sobre la lista ya cargada, sin volver a llamar a la API.
    private List<InstrumentDTO> FilteredInstruments => instruments!
        .Where(i => (string.IsNullOrWhiteSpace(searchText) || Matches(i, searchText.Trim()))
                    && (statusFilter == string.Empty || i.Status == statusFilter)
                    && (areaFilter == string.Empty || i.AreaName == areaFilter)
                    && (!hideDecommissioned || i.Status != nameof(InstrumentStatusDTO.Decommissioned)))
        .ToList();

    // Con filtros activos el subtítulo cambia a "N de M instrumentos"; sin filtros queda en null y el
    // encabezado usa el conteo normal.
    private string? FilterSubtitle =>
        instruments != null && HasFilters ? $"{FilteredInstruments.Count} de {instruments.Count} instrumentos" : null;

    private static bool Matches(InstrumentDTO instrument, string text) =>
        Contains(instrument.Code, text) || Contains(instrument.Name, text)
        || Contains(instrument.Brand, text) || Contains(instrument.Model, text);

    private static bool Contains(string? value, string text) =>
        value != null && value.Contains(text, StringComparison.OrdinalIgnoreCase);

    private static string BrandAndModel(InstrumentDTO instrument) =>
        string.Join(" ", new[] { instrument.Brand, instrument.Model }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // Tocar la fila abre el detalle del instrumento.
    private void OpenDetails(InstrumentDTO instrument) => NavigationManager.NavigateTo($"instruments/{instrument.Id}");

    private void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = string.Empty;
        areaFilter = string.Empty;
        hideDecommissioned = false;
    }

    private async Task LoadInstruments()
    {
        try
        {
            instruments = await InstrumentApiClient.GetAllAsync();

            areaNames = instruments
                .Select(i => i.AreaName)
                .Where(name => !string.IsNullOrEmpty(name))
                .Distinct()
                .OrderBy(name => name)
                .ToList();

            // Si se eliminó el último instrumento de un área, ese filtro ya no tiene sentido.
            if (!areaNames.Contains(areaFilter))
                areaFilter = string.Empty;
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
            instruments = new List<InstrumentDTO>();
        }
    }

    private async Task DeleteAsync(InstrumentDTO instrument)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el instrumento \"{instrument.Code}\"?");
        if (!confirmed)
            return;

        try
        {
            await InstrumentApiClient.DeleteAsync(instrument.Id);
            errorMessage = null;
            await LoadInstruments();
            Flash.Success($"Instrumento \"{instrument.Code}\" eliminado.");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ApiError.Message(ex);
        }
    }
}
