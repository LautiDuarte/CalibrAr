<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 m-0">@Title</h1>
        @if (SubtitleText != null)
        {
            <div class="text-secondary small">@SubtitleText</div>
        }
    </div>
    <div>@Actions</div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    // Si no se indica Subtitle y sí Count, se muestra "N registros".
    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public int? Count { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private string? SubtitleText => Subtitle ?? (Count.HasValue ? (Count == 1 ? "1 registro" : $"{Count} registros") : null);
}
