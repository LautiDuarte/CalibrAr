@using System.ComponentModel.DataAnnotations

<EditForm Model="Model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="name">Nombre</label>
        <InputText id="name" @bind-Value="Model.Name" />
        <ValidationMessage For="() => Model.Name" />
    </div>

    <div class="field">
        <label for="description">Descripción</label>
        <InputText id="description" @bind-Value="Model.Description" />
    </div>

    <div class="field">
        <label for="unit">Unidad</label>
        <InputText id="unit" @bind-Value="Model.MeasurementUnit" />
        <ValidationMessage For="() => Model.MeasurementUnit" />
    </div>

    <div class="field">
        <label for="maxError">Error máximo</label>
        <InputNumber id="maxError" @bind-Value="Model.MaxAllowedError" />
        <ValidationMessage For="() => Model.MaxAllowedError" />
    </div>

    <div class="field">
        <label for="frequency">Frecuencia (meses)</label>
        <InputNumber id="frequency" @bind-Value="Model.CalibrationFrequencyMonths" />
        <ValidationMessage For="() => Model.CalibrationFrequencyMonths" />
    </div>

    <div class="field">
        <label for="isActive">Activo</label>
        <InputCheckbox id="isActive" @bind-Value="Model.IsActive" />
    </div>

    <div class="actions">
        <button type="submit" disabled="@Saving">Guardar</button>
        <a href="instrument-types">Cancelar</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public InstrumentTypeFormModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public bool Saving { get; set; }

    public class InstrumentTypeFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        [Required(ErrorMessage = "La unidad de medida es obligatoria.")]
        public string MeasurementUnit { get; set; } = string.Empty;

        // Sin las opciones invariantes, con cultura es-AR "0.0001" no se puede convertir y valida con excepción.
        [Range(typeof(decimal), "0.0001", "999999", ParseLimitsInInvariantCulture = true, ConvertValueInInvariantCulture = true,
            ErrorMessage = "El error máximo debe ser mayor a 0.")]
        public decimal MaxAllowedError { get; set; }

        [Range(1, 1200, ErrorMessage = "La frecuencia debe ser mayor a 0.")]
        public int CalibrationFrequencyMonths { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
